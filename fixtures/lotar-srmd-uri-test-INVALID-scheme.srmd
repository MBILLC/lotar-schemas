<!--
  Dedicated URI-restriction test fixture (2026-07-22): @data="C:\resources\Comp1.fmu" exercises
  BOTH SRMD-ARCH-100d (backslash) and SRMD-ARCH-100e (drive-letter/scheme, since "C:" is the
  first path segment before any "/") simultaneously — a Windows absolute path naturally trips
  both checks at once, which is expected and documents why the two checks are independent (a
  forward-slash drive path like "C:/resources/Comp1.fmu" would trip 100e only, not 100d).
-->
<srmd:SimulationResourceMetaData
    xmlns:srmd="http://ssp-standard.org/SSPTraceability1/SimulationResourceMetaData"
    version="1.0.0"
    name="LOTAR-SRMD-URI-Test-Invalid-Scheme"
