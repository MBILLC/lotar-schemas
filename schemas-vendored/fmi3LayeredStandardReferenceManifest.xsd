    <xs:import namespace="http://fmi-standard.org/fmi-ls-manifest" schemaLocation="fmi3LayeredStandardManifest.xsd"/>
    <xs:include schemaLocation="fmi3Annotation.xsd"/>
    <xs:annotation>
        <xs:documentation>
