<?xml version="1.0" encoding="UTF-8"?>
<!--
    Minimal, hand-reconstructed XLink attribute declarations, sufficient for the `xlink:type`,
    `xlink:href`, `xlink:role`, `xlink:arcrole`, `xlink:title`, `xlink:label`, `xlink:from`,
    `xlink:to`, `xlink:show`, `xlink:actuate` attribute references used by STC.xsd's Links/Locator/
    Arc/ClassificationEntry/Classification declarations. This is NOT a byte-identical copy of the
    W3C original (https://www.w3.org/XML/2008/06/xlink.xsd) — it was reconstructed offline because
    that URL wasn't reliably fetchable at authoring time. If you have network access to w3.org at
    validation time, prefer fetching the authoritative file and pointing your schema loader at that
    instead; this file exists so schema-conformance validation works fully offline in the meantime.
    targetNamespace matches the real XLink 1.1 namespace, so either file is interchangeable from the
    STC/STMD/DTMD/MTMD/SRMD schemas' point of view.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://www.w3.org/1999/xlink"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    elementFormDefault="qualified" attributeFormDefault="qualified">

    <xs:attribute name="type">
        <xs:simpleType>
            <xs:restriction base="xs:token">
                <xs:enumeration value="simple"/>
                <xs:enumeration value="extended"/>
                <xs:enumeration value="locator"/>
                <xs:enumeration value="arc"/>
                <xs:enumeration value="resource"/>
                <xs:enumeration value="title"/>
                <xs:enumeration value="none"/>
            </xs:restriction>
        </xs:simpleType>
    </xs:attribute>

    <xs:attribute name="href" type="xs:anyURI"/>
    <xs:attribute name="role" type="xs:anyURI"/>
    <xs:attribute name="arcrole" type="xs:anyURI"/>
    <xs:attribute name="title" type="xs:string"/>

    <xs:attribute name="show">
        <xs:simpleType>
            <xs:restriction base="xs:token">
                <xs:enumeration value="new"/>
                <xs:enumeration value="replace"/>
                <xs:enumeration value="embed"/>
                <xs:enumeration value="other"/>
                <xs:enumeration value="none"/>
            </xs:restriction>
        </xs:simpleType>
    </xs:attribute>

    <xs:attribute name="actuate">
        <xs:simpleType>
            <xs:restriction base="xs:token">
                <xs:enumeration value="onLoad"/>
                <xs:enumeration value="onRequest"/>
                <xs:enumeration value="other"/>
                <xs:enumeration value="none"/>
            </xs:restriction>
        </xs:simpleType>
    </xs:attribute>

    <xs:attribute name="label" type="xs:NCName"/>
    <xs:attribute name="from" type="xs:NCName"/>
    <xs:attribute name="to" type="xs:NCName"/>
</xs:schema>
