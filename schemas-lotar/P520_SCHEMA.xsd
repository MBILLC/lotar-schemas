    <!--
        ==========================================================================
        Behavioral-model test cases (integrated from NAS9300-515, D-23, 2026-09-05)
        ==========================================================================
        The types below were authored under P515_SCHEMA.xsd and moved here verbatim
        (except for the P515_Related_Type -> P520_Related_Type rename and the file/rule-id
        references) when the behavioral-model part of P515 was integrated into P520. A
        TestCase now nests under Verification_Validation_Scenario_Type (Option A,
        P515_P520_Integration_Plan.md Sec.2.1): a scenario is the V&V intent, its test cases
        are the concrete experiments with reference results that realize it. The former
        P515 root (P515_ManifestType) and BehavioralModelReportType (ModelLinking + TestCase
        list) were not moved: the model link is the enclosing P520 manifest itself.
        Original design history: planning/P515_FMI_LS_Ref_Plan.md, decisions log 2026-07-20.
    -->
    <!--
        P520_Related_Type (2026-07-20) — FMI-LS-ref-based file-artifact link type
        ==========================================================================
        Decision (executing P515_FMI_LS_Ref_Plan.md §3/§6 (design record; content now lives in P520, D-23), assuming fmi-ls-ref PR #36 is
        merged): concrete file artifacts referenced from a test case — the InputFile and
        ReferenceResults elements below — migrate from the generic p500:Traceability_Link_Type
        to this FMI-LS-ref-derived type, since that is exactly what TRelated was built for and
        exactly where PD1 (fixity/checksum) and PD4 (size) bite hardest. ModelLinking and
        Context.ContextLink are NOT migrated: they stay on p500:Traceability_Link_Type, since
        they link to other Digital Objects/contexts (inter-object relationships, PD8/GR4/D5,
        already deferred to P550) rather than to a single concrete file whose bytes need fixity
        and size captured.

        TRelated (no target namespace; imported unqualified above) already provides @source,
        @role, @type (MIME), @description, and @checksum/@checksumType — but @checksum is only
        OPTIONAL there. XSD extension cannot tighten an inherited attribute's `use` from
        optional to required in the same step it adds a new attribute (that would require
        restriction, which is mutually exclusive with extension here) — so @checksum is left
        as declared by the base type, and lotar-p520-archival.sch enforces it as mandatory for
        archival on InputFile, mirroring the FMI2/FMI3 archival Schematron pattern exactly.
        ReferenceResults is the one exception (revised 2026-07-20): its @checksum is NOT
        Schematron-enforced, because the pre-existing sibling element ReferenceFileHash already
        carries a fixity digest of the same reference results file — ReferenceFileHash is kept
        as the sole authoritative mechanism for that one field, to avoid two parallel hashes of
        one artifact; see the ReferenceResults element's own annotation below for detail.

        sizeBytes is added here because TRelated has no size-in-bytes field at all (a gap
        flagged in P515_FMI_LS_Ref_Plan.md §5); this follows the plan's recommended Option A
        (a required attribute on an extension) over Option B (carrying size via TRelated's
        Annotations extensibility point), since PD4 warrants a schema-level guarantee rather
        than a loosely-coupled annotation.

        (Historical note: in P515 this type carried xmlns="" to reach the no-namespace
        TRelated. Dropped on integration; this schema now has no default namespace at all, so
        the unprefixed base="TRelated" below is a no-namespace reference by construction. See
        the import's comment near the top of this file.)
    -->
    <xs:complexType name="P520_Related_Type">
        <xs:annotation>
            <xs:documentation>
                Extension of fmi-ls-ref's TRelated adding a mandatory sizeBytes attribute
                (PD4). Used for concrete file-artifact links (InputFile, ReferenceResults);
                see the block comment above for the full rationale and the ModelLinking/
                ContextLink exclusion.
            </xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="TRelated">
                <xs:attribute name="sizeBytes" type="xs:nonNegativeInteger" use="required">
                    <xs:annotation>
                        <xs:documentation>
                            Size of the referenced file in bytes, required for archival (PD4).
                            Not present on the upstream TRelated base type.
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="TestCaseType" >
        <xs:sequence>
            <xs:element name="Context" type="tns:ContextType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation> Context information for the test case. </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Scenario" type="tns:ScenarioType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation> Scenario definition for the test case. </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="ReferenceVariables" type="tns:ReferenceVariablesType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation> Reference variables and expected results for the test case. </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="optional">
            <xs:annotation>
                <xs:documentation>Fragment anchor for one test case (D-24): an STMD ImplementTestCase/Output may
                    reference it as P520_Manifest.xml#&lt;id&gt;.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="ContextType" >
        <xs:sequence>
            <xs:element name="Number" type="xs:int" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation> Identifier number for the test case context. </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Description" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation> Description of the test case context. </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ContextLink" type="p500:Traceability_Link_Type" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation> Links related to the test case context. </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Relative_path" type="xs:string" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation> Relative paths relevant to the test case context. </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ScenarioType" >
        <xs:sequence>
            <xs:element name="ExperimentDefinition" type="tns:ExperimentDefinitionType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation> Definition of the experiment for the test case scenario. </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="PropertyModifications" type="tns:PropertyModificationsType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation> Modifications to properties for the test case scenario. </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="BoundaryConditions" type="tns:BoundaryConditionsType" minOccurs="1" maxOccurs="1">
