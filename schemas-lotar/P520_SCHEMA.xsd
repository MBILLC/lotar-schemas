        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PropertyModificationsType" >
        <xs:sequence>
            <xs:element name="Property" type="tns:VariableNameValueModType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation> Property modifications for the test case scenario. </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="BoundaryConditionsType" >
        <xs:sequence>
            <xs:element name="Constant" type="tns:VariableNameValueModType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation> Constant boundary conditions for the test case scenario. </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="InputFile" type="tns:P520_Related_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation> Input file for boundary conditions in the test case
                        scenario. Migrated 2026-07-20 from p500:Traceability_Link_Type to
                        P520_Related_Type (FMI-LS-ref-based; see the type definition above).
                        @role is required to be "configuration" (revised 2026-07-21; supersedes
                        the 2026-07-20 "parameter" confirmation — closed enum inherited from
                        TRelated has no boundary-condition-specific value, "configuration" is now
                        the confirmed fit), enforced by lotar-p520-archival.sch's
                        P520-ARCH-100d. </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ReferenceVariablesType" >
        <xs:sequence>
            <xs:element name="Variable" type="xs:string" minOccurs="1" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation> Reference variable names for the test case. </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Tolerance" type="tns:ToleranceType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation> Tolerance settings for the reference variables. </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ReferenceResults" type="tns:P520_Related_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation> Link to the reference results file for the test case.
                        Migrated 2026-07-20 from p500:Traceability_Link_Type to
                        P520_Related_Type (FMI-LS-ref-based; see the type definition above).
                        @role is required to be "result" (confirmed 2026-07-20; best fit in
                        TRelated's closed enum), enforced by lotar-p520-archival.sch's
                        P520-ARCH-101b. NOTE (resolved 2026-07-20): this element's own
                        @checksum/@checksumType are inherited from TRelated and remain
                        structurally permitted, but are deliberately NOT required for
                        archival — the sibling ReferenceFileHash element below is the sole
                        authoritative fixity mechanism for the reference results file, to
                        avoid two parallel, potentially-diverging hashes of the same
                        artifact. </xs:documentation>
                </xs:annotation>
            </xs:element>
            <!-- Definition of the ReferenceFileHash element (sole authoritative fixity
                 mechanism for the reference results file — see the note on ReferenceResults
                 above; reinforced as mandatory in lotar-p520-archival.sch,
                 P520-ARCH-102/103, 2026-07-20). -->
            <xs:element name="ReferenceFileHash">
                <xs:complexType>
                <xs:attribute name="type" use="required">
                    <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <!-- Restrict the type attribute to specific hash algorithms -->
                        <xs:enumeration value="sha256"/>
                        <xs:enumeration value="sha1"/>
                        <xs:enumeration value="md5"/>
                    </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="value" use="required">
                    <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <!-- Restrict value to a valid hexadecimal string -->
                        <xs:pattern value="[0-9a-fA-F]{64}"/>
                    </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ToleranceType" >
        <xs:sequence>
            <xs:element name="Absolute_tolx" type="xs:float" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation> Absolute tolerance for the x variable. </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Absolute_toly" type="xs:float" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation> Absolute tolerance for the y variable. </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Relative_tolx" type="xs:float" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation> Relative tolerance for the x variable. </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Relative_toly" type="xs:float" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation> Relative tolerance for the y variable. </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>


    <xs:simpleType name="AlgorithmType">
        <xs:annotation>
            <xs:documentation> Numerical algorithm used in the experiment.</xs:documentation>
        </xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FMICSAlg"/>
			<xs:enumeration value="Euler-Explicit"/>
			<xs:enumeration value="Euler-Implicit"/>
			<xs:enumeration value="Runge-Kutta-2"/>
		</xs:restriction>
	</xs:simpleType>

     <xs:complexType name="VariableNameValueModType" >
        <xs:annotation>
            <xs:documentation> Structure to define variable name and its modified value. </xs:documentation>
        </xs:annotation>
         <xs:attribute name="name" type="xs:string" use="required"/>
         <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>

     <!--
        Note: unlike GeneralPLMInfoType/Traceability_Link_Type/LinkTypeInterpretation/ContentTypeType,
        Verification_Validation_Type was never present in P515_SCHEMA.xsd, so it stays specific to P520
        rather than moving to the common schema (the original "Common" label in this file was
        aspirational, not actually shared).
     -->
 <xs:complexType name="Verification_Validation_Type">
		<xs:sequence>
			<xs:element name="Verification_Validation_Scenario" type="tns:Verification_Validation_Scenario_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation> Verification and validation scenarios for the model. </xs:documentation>
				</xs:annotation>
			</xs:element>

    	</xs:sequence>
	</xs:complexType>

	<xs:complexType name="Verification_Validation_Scenario_Type">
		<xs:sequence>
			<xs:element name="Id" type="xs:string">
				<xs:annotation>
					<xs:documentation> Identifier for the verification/validation scenario. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Verification_Credibility_Level" type="xs:string">
				<xs:annotation>
					<xs:documentation> Verification credibility level for the scenario. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Validation_Credibility_Level" type="xs:string">
				<xs:annotation>
					<xs:documentation> Validation credibility level for the scenario. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:choice minOccurs="0">
				<xs:element name="Validated_by" type="p500:Traceability_Link_Type">
					<xs:annotation>
						<xs:documentation> Link to the resource that validates the model. </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Verified_by" type="p500:Traceability_Link_Type">
					<xs:annotation>
						<xs:documentation> Link to the resource that verifies the model. </xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
			<!-- Validated_by/Verified_by relaxed to optional (D-23): a scenario's evidence may
			     instead be its inline TestCase elements below. lotar-p520-archival.sch's
			     P520-ARCH-003 requires at least one of TestCase, Validated_by, Verified_by. -->
			<xs:element name="Model_Summary_Report" type="xs:anyURI">
				<xs:annotation>
					<xs:documentation> URI to the summary report of the model verification/validation. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Implements" type="p500:Traceability_Link_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Link from this scenario's Model Report to the governing Credible Decision
						Process (CDP) record (a DTMD instance, org.lotar-international.lotar-core's
						SSP-LS-Traceability-based process schema) that triggered the simulation
						effort this scenario documents. Distinct from Validated_by/Verified_by
						above, which link to external test-case/reference-result artifacts (formerly P515-governed;
						inline TestCase elements below are the integrated form, D-23)
						that verify or validate the model itself; the CDP decision sits logically
						"above" the Model Report (it is what commissioned the work in the first
						place), not beside it as another verification/validation artifact, hence a
						separate element rather than a third choice branch. Populate Name with
						"implements" (Traceability_Link_Type's free-text relationship-name field) to
						record the relation explicitly, mirroring this project's existing
						relation-labeling convention (see NAS9300-500 Appendix B's
						&lt;relation&gt;('Uses', ...)&lt;/relation&gt; pattern). Optional at the XSD
						level (not every scenario is necessarily governed by a recorded CDP
						decision); see the P520 risk-profile normative clause for when population is
						actually mandatory.

						Placement (D-21b, decided 2026-08-06): Link must be a bare filename (no
						path separator) resolving to a .dtmd file located in the SAME folder as the
						P520_Manifest.xml instance that contains this element. This is one per-model
						folder holding three siblings: the P520_Manifest.xml itself, the governing
						.dtmd record, and the SSP or FMU package this manifest describes (the
						package's own internal layout is unaffected by this rule). See
						P520_Risk_Profile_Normative_Clause.md Sec.5.7 for the concrete layout and
						lotar-p520-uri.sch's P520-ARCH-002 pattern for the enforced syntax rules.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TestCase" type="tns:TestCaseType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>
						Behavioral-model test case realizing this scenario (integrated from
						P515, D-23): numerical experiment definition, property/boundary-condition
						overrides, reference variables with tolerances, and the reference-results
						file with its fixity hash. One scenario may carry several test cases
						(operating points, solvers). The risk-scaled STMD/MTMD steps
						DefineTestCaseRequirements / DefineTestCaseDesignSpecification /
						ImplementTestCase point at this content (P520 risk-profile clause Sec.4.4).
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="id" type="xs:ID" use="optional">
			<xs:annotation>
				<xs:documentation>Fragment anchor (D-24, 2026-09-05): a process record points at this scenario with
					stc:ResourceReference xlink:href="P520_Manifest.xml#&lt;id&gt;", the credible-process layer's
					fragment convention (credible-process-schemas docs/07-conformance.md). Optional; required in
					practice whenever an STMD step's Output references this scenario (P520 clause Sec. 4.5.3).</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>



<xs:element name="P520_Manifest" type="tns:P520_ManifestType">
	<xs:annotation>
		<xs:documentation> Root element for the P520 Manifest schema. </xs:documentation>
	</xs:annotation>
</xs:element>


</xs:schema>
