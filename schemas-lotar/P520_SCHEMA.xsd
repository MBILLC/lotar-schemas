                    <xs:documentation> Boundary conditions for the test case scenario. </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ExperimentDefinitionType" >
        <xs:sequence>
            <xs:element name="Algorithm" type="tns:AlgorithmType" minOccurs="1" maxOccurs="1">
